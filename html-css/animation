<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <title>animation</title>
</head>
<body>
    <style>
        @keyframes hat{
            0%{background-color: aqua;}
            25%{background-color: blueviolet;}
            50%{background-color: yellowgreen;}
            100%{background-color: black;}
        }
        div{
            height: 100px;
            width: 100px;
            background-color: blanchedalmond;
            animation-name: hat;
            animation-duration: 4s;
        }
        </style>
</body>
</html>